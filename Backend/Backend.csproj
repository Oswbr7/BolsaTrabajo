<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.8" />
    <!-- Envío real del código de verificación por correo (ver "Plan de
         Implementacion - Integracion Brevo para Verificacion por Correo.md").
         SDK oficial de Brevo. -->
    <PackageReference Include="brevo_csharp" Version="1.1.3" />
    <!-- Envío real del código de verificación por SMS (ver "Plan de
         Implementacion - Integracion Vonage SMS para Verificacion.md").
         SDK oficial de Vonage. -->
    <PackageReference Include="Vonage" Version="7.9.0" />
  </ItemGroup>

</Project>
